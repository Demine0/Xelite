<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity Name="Xelite.XrayVPN" Publisher="CN=Xelite" Version="1.38.0.0" />

  <mp:PhoneIdentity PhoneProductId="76e87a7b-34b0-4416-ae95-f9d2f82abab5" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Xelite</DisplayName>
    <PublisherDisplayName>Xelite</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 15063 is the newest SDK level Windows 10 Mobile (build 15254) accepts. -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.15063.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Xelite.App">
      <uap:VisualElements
        DisplayName="Xelite"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Xray-core VPN client with subscriptions"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Xelite">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B1426" />
      </uap:VisualElements>
    </Application>

    <!--
      Hidden second application that hosts the VPN plug-in, as in Microsoft's UwpVpnPluginSample.
      "vpnClient" tasks need a custom host (Executable), and a separate Application keeps the
      plug-in in its own process, so closing the UI doesn't stop the tunnel.
    -->
    <Application Id="Plugin">
      <uap:VisualElements
        DisplayName="Xelite"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Xelite VPN plug-in"
        BackgroundColor="transparent"
        AppListEntry="none">
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B1426" />
      </uap:VisualElements>
      <Extensions>
        <!-- The VPN platform only activates "vpnClient" tasks; it must be the only task type here. -->
        <!-- XeliteVpnHost.exe has no XAML, so Windows does not suspend it together with the app. -->
        <Extension Category="windows.backgroundTasks" Executable="XeliteVpnHost.exe" EntryPoint="Xelite.VpnTask.VpnBackgroundTask">
          <BackgroundTasks>
            <uap:Task Type="vpnClient" />
          </BackgroundTasks>
        </Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="networkingVpnProvider" />
  </Capabilities>
</Package>
