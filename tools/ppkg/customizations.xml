<?xml version="1.0" encoding="utf-8"?>
<!--
  Provisioning package for the phone: only the VPN's own addresses (198.18.0.0/15)
  count as private network for app isolation. Without it Windows counts the
  internet behind Xelite's routes as private, and apps without the private network
  capability (Edge's pages) get "Access Denied" on every connect.
  Remove it in Settings > Accounts > Access work or school > provisioning packages.
-->
<WindowsCustomizations>
  <PackageConfig xmlns="urn:schemas-Microsoft-com:Windows-ICD-Package-Config.v1.0">
    <ID>{5bf36afd-870c-40de-8b58-c403892e1b6a}</ID>
    <Name>Xelite network isolation</Name>
    <Version>1.0</Version>
    <OwnerType>ITAdmin</OwnerType>
    <Rank>0</Rank>
    <Notes>Only 198.18.0.0/15 (Xelite VPN) is private network for apps.</Notes>
  </PackageConfig>
  <Settings xmlns="urn:schemas-microsoft-com:windows-provisioning">
    <Customizations>
      <Common>
        <Policies>
          <NetworkIsolation>
            <EnterpriseIPRange>198.18.0.0/15</EnterpriseIPRange>
            <EnterpriseIPRangesAreAuthoritative>1</EnterpriseIPRangesAreAuthoritative>
          </NetworkIsolation>
        </Policies>
      </Common>
    </Customizations>
  </Settings>
</WindowsCustomizations>
